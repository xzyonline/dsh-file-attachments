{
  "name": "@dsh-external/dsh-file-attachments",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@keep-lts/xlsx": "^0.18.6",
    "cfb": "^1.2.2",
    "fflate": "0.8.3",
    "file-type": "22.0.1",
    "pdfjs-dist": "6.2.108",
    "react": "18.3.1",
    "word-extractor": "^1.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.28",
    "@types/supertest": "6.0.3",
    "jsdom": "26.1.0",
    "react-dom": "18.3.1",
    "supertest": "7.1.4",
    "tsdown": "0.15.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/install.mjs",
    "undeploy": "node scripts/install.mjs --uninstall"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
